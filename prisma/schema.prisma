datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String
  phone            String
  role             String            // "seafarer" | "company-admin" | "master"
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  profile          SeafarerProfile?
  enrollments      Enrollment[]
  documents        Document[]
  notifications    Notification[]
  supportTickets   SupportTicket[]
}

model SeafarerProfile {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dob              String?
  nationality      String?
  indosNumber      String?
  address          String?
  profilePicture   String?
  seaService       SeaServiceRecord[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model SeaServiceRecord {
  id               String          @id @default(uuid())
  profileId        String
  profile          SeafarerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  vesselName       String
  imoNumber        String
  rank             String
  signOn           String          // Sign-on date string (YYYY-MM-DD)
  signOff          String          // Sign-off date string (YYYY-MM-DD)
  company          String
  createdAt        DateTime        @default(now())
}

model Course {
  id                String       @id @default(uuid())
  code              String       @unique
  name              String
  description       String
  duration          String
  level             String
  icon              String
  category          String       // "basic" | "advanced" | "refresher" | "additional"
  image             String
  fees              String
  documentsRequired String       // Comma-separated or JSON array string
  rating            Float        @default(4.5)
  ratingCount       Int          @default(0)
  enrollments       Enrollment[]
}

model Enrollment {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status         String    // "active" | "completed"
  progress       Int       @default(0)
  startDate      DateTime  @default(now())
  completionDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, courseId])
}

model Document {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "cdc" | "passport" | "medical" | "stcw"
  name        String
  url         String
  status      String   // "pending" | "verified" | "rejected"
  uploadDate  DateTime @default(now())
  expiryDate  String?  // Expiry date string (YYYY-MM-DD)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  description String
  status      String   // "open" | "replied" | "closed"
  replies     String   // JSON string of replies array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
